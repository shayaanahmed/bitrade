# Server-only Binance credentials. Never prefix these with NEXT_PUBLIC_.
# Start with a read-only API key (Enable Reading); do not enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Live Binance API. For Spot Testnet use https://testnet.binance.vision instead.
BINANCE_BASE_URL=https://api.binance.com
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Safety switch. Keep false for read-only balances and simulated orders.
# When true, the existing quick-order panel can submit real Spot orders after confirmation.
BINANCE_ENABLE_TRADING=false

# Commodity-history API key. The free Alpha Vantage tier is supported.
ALPHA_VANTAGE_API_KEY=

# Server-only Telegram bot token used by the Signals page.
# Create a bot with @BotFather, then add it to the target chat/channel.
TELEGRAM_BOT_TOKEN=

# Background scanner timing. Defaults: scan every 30s, retry failed delivery every 5m.
SIGNAL_SCAN_INTERVAL_MS=30000
SIGNAL_RETRY_INTERVAL_MS=300000

# Host port exposed by Docker. Change this when port 3000 is already occupied.
TRADEPILOT_PORT=3030

# Used for absolute social metadata when deployed behind a domain.
SITE_URL=http://localhost:3030
